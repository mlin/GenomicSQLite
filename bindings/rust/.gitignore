# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock pins dependencies for reproducible CI and development builds.
# Downstream consumers resolve their own dependencies.

# These are backup files generated by rustfmt
**/*.rs.bk

# planted prebuilt libraries, in per-target directories (release pipeline)
lib/*/libgenomicsqlite.so
lib/*/libgenomicsqlite.dylib
