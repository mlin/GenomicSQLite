#!/bin/bash
# wrapper for cargo that generates Cargo.toml from Cargo.toml.in, filling in git revision as
# crate version
set -e
cd `dirname $0`

revision="$(git describe --tags --abbrev=0)"
# -dirty only for changes other than the tracked Cargo.lock: builds rewrite
# the lock's root-package version entry, and that must not feed back into
# the version itself (which would rewrite the lock again on the next run).
if git status --porcelain --untracked-files=no | grep -v 'Cargo.lock' | grep -q .; then
    revision="${revision}-dirty"
fi
revision="${revision#v}"  # strip 'v' prefix
>&2 echo "$revision"

sed "s/{{GENOMICSQLITE_VERSION}}/${revision}/" Cargo.toml.in > Cargo.toml
cargo "$@"
